# Docker Compose local development only. Do not commit the copied .env file.
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
JWT_PASSWORD=replace-with-a-long-random-secret
ADMIN_SIGNUP_SECRET=replace-with-a-separate-random-setup-secret

PORT=3000
FRONTEND_URL=http://localhost:5173

# Used by the HTTP API for LiveKit token generation.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://localhost:7880

# Optional. @ai chat replies require an OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

