# --------------------
# Stage 1: Install Dependencies
# --------------------
FROM node:20-alpine AS installer

WORKDIR /app

# Enable Corepack
RUN corepack enable npm

# Add native deps
RUN apk add --no-cache openssl libc6-compat

# ✅ STEP 1: Copy ONLY package files first (monorepo root + workspaces)
COPY package.json package-lock.json turbo.json ./
COPY packages/db/package.json ./packages/db/package.json
COPY apps/ws/package.json ./apps/ws/package.json
COPY apps/http/package.json ./apps/http/package.json

# ✅ STEP 2: Install deps (cached until package files change)
RUN npm install --legacy-peer-deps

# ✅ STEP 3: Copy source code AFTER install
COPY packages ./packages
COPY apps ./apps

# --------------------
# Stage 2: Dev Runtime
# --------------------
FROM node:20-alpine AS dev

WORKDIR /app

RUN corepack enable npm
RUN apk add --no-cache openssl libc6-compat

ENV LD_PRELOAD=/lib/libc.so.6

# Copy from installer
COPY --from=installer /app /app

WORKDIR /app/apps/ws

EXPOSE 3001

CMD ["npm", "run", "dev"]
