FROM node:18-alpine

WORKDIR /app

# ✅ STEP 1: Copy ONLY package files first (best caching)
COPY apps/frontend/package.json ./

# ✅ STEP 2: Install dependencies (cached until package.json changes)
RUN npm install --legacy-peer-deps

# ✅ STEP 3: Copy rest of app AFTER install (changes won't trigger reinstall)
COPY apps/frontend ./

# Expose Vite dev server port
EXPOSE 5173

# Run Vite with host flag
CMD ["npm", "run", "dev", "--", "--host"]
